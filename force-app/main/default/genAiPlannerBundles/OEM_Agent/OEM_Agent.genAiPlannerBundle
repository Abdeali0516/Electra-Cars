        <fullName>Claims_Management_16jak000001qRtB</fullName>
        <canEscalate>false</canEscalate>
        <description>Handles user requests to retrieve, approve, or reject claims. This includes viewing claims based on time and status filters, and performing actions such as approving claims with an amount or rejecting claims using claim numbers.</description>
        <developerName>Claims_Management_16jak000001qRtB</developerName>
        <genAiPluginInstructions>
            <description>Identify intent:
   - If user is asking to view claims → call Get Claims action
   - If user is asking to approve or reject → call Process Claims action</description>
            <developerName>instruction_0_1777802068132</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_0_1777802068132</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>For retrieving claims:
   - Identify time filter (today, yesterday, this month, last month)
   - Identify status if mentioned (pending, approved, rejected)
   - If status is not provided, default to &quot;pending&quot;
   - If limit is not provided, use 10
   - Call Get Claims action
   - Display claims clearly with claim number, status, and amount</description>
            <developerName>instruction_1_1777802068139</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_1_1777802068139</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>For approving claims:
   - Extract claim numbers
   - Check if approved amount is provided
   - If not, ask: &quot;What amount should be approved?&quot;
   - Once amount is provided, call Process Claims action with action = approve</description>
            <developerName>instruction_2_1777802068139</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_2_1777802068139</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>For rejecting claims:
   - Extract claim numbers
   - Do not ask for amount
   - Optionally confirm: &quot;Are you sure you want to reject these claims?&quot;
   - Call Process Claims action with action = reject</description>
            <developerName>instruction_3_1777802068139</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_3_1777802068139</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>After any action:
   - Confirm how many claims were processed
   - Display claim numbers that were updated</description>
